import Foundation
import HarmonyCore
import KiraUI

// What the assistant's views read.
//
// A component has no build pass of its own -- there is no window, so nothing
// calls a rebuild predicate and `@State` has nowhere to live -- so the turn the
// views draw is kept in a native slot beside the surfaces and written by the
// loop that owns it. The views ask questions; this answers them, and neither
// knows the other is in a process with no window in it.

struct AiActivityFact {
    var kind: String = ""
    var name: String = ""
    var detail: String = ""
    var state: String = ""
}

struct AiViewFacts {
    var conversation: ConversationId = conversationNone()
    var prompt: String = ""
    var answer: String = ""
    var running: Bool = false
    var runtimeReady: Bool = false
    var model: String = ""
    var note: String = ""
    var activities: [AiActivityFact] = []
    // UI callbacks write requests here; the component loop consumes them and is
    // still the only owner of the harness connection.
    var pendingPrompt: String = ""
    var pendingCancelRaw: Int = 0
    var nextConversationRaw: Int = 1
}

function aiViewSlotKey() -> String {
    return "harmony.ai.views"
}

function aiViewFactsEnsure() {
    if kiraUiStateSlotHas(aiViewSlotKey()) {
        return
    }
    kiraUiStateSlotPut(aiViewSlotKey(), nativeUserData(nativeState(AiViewFacts {})))
    return
}

function aiViewFacts() -> AiViewFacts {
    aiViewFactsEnsure()
    return nativeRecover<AiViewFacts>(kiraUiStateSlotGet(aiViewSlotKey()))
}

// What the harness can do, recorded when it says so.
//
// Separate from the turn because it changes on its own: a harness that finds its
// key is a harness whose note stops being the reason it cannot answer, and a
// column still showing the old one is a column telling somebody to fix something
// they have just fixed.
function aiViewRecordHarness(ready: Bool, model: borrow String, note: borrow String) {
    aiViewFactsEnsure()
    var facts = nativeRecover<AiViewFacts>(kiraUiStateSlotGet(aiViewSlotKey()))
    facts.runtimeReady = ready
    facts.model = model
    facts.note = note
    return
}

// Begins a turn: the conversation it belongs to and what was asked, with a blank
// answer waiting to be filled by the deltas that follow.
function aiViewStartTurn(conversation: ConversationId, prompt: borrow String) {
    aiViewFactsEnsure()
    var facts = nativeRecover<AiViewFacts>(kiraUiStateSlotGet(aiViewSlotKey()))
    facts.conversation = conversation
    facts.prompt = prompt
    facts.answer = ""
    facts.running = true
    facts.activities = []
    if conversation.raw >= facts.nextConversationRaw {
        facts.nextConversationRaw = conversation.raw + 1
    }
    return
}

// Adds one delta's text to the answer as it streams in.
function aiViewAppendAnswer(text: borrow String) {
    aiViewFactsEnsure()
    var facts = nativeRecover<AiViewFacts>(kiraUiStateSlotGet(aiViewSlotKey()))
    facts.answer = facts.answer + text
    return
}

// Ends a turn. A failed turn's reason is already its last delta's text, so the
// answer stands as it is; this only stops the caret.
function aiViewFinishTurn() {
    aiViewFactsEnsure()
    var facts = nativeRecover<AiViewFacts>(kiraUiStateSlotGet(aiViewSlotKey()))
    facts.running = false
    return
}

// Records one observable tool or delegated-agent step. Completion updates the
// row that began the step instead of appending a second copy, so the activity
// feed reads as a run timeline rather than a wire log.
function aiViewRecordActivity(conversation: ConversationId, kind: borrow String, name: borrow String, detail: borrow String, state: borrow String) {
    aiViewFactsEnsure()
    var facts = nativeRecover<AiViewFacts>(kiraUiStateSlotGet(aiViewSlotKey()))
    if conversationSame(facts.conversation, conversation) == false {
        return
    }
    var found = -1
    var index = 0
    while index < facts.activities.count {
        let item = facts.activities[index]
        if item.kind == kind && item.name == name && item.state == "started" {
            found = index
        }
        index = index + 1
    }
    if state != "started" && found >= 0 {
        facts.activities[found].detail = detail
        facts.activities[found].state = state
        return
    }
    facts.activities.append(AiActivityFact {
        kind: kind,
        name: name,
        detail: detail,
        state: state
    })
    return
}

function aiComposerKey() -> Int {
    return 41001
}

function aiSubmitComposer() {
    let prompt = textFieldText(aiComposerKey()).trim()
    if prompt.count == 0 {
        return
    }
    aiViewFactsEnsure()
    var facts = nativeRecover<AiViewFacts>(kiraUiStateSlotGet(aiViewSlotKey()))
    facts.pendingPrompt = prompt
    textFieldReset(aiComposerKey())
    return
}

function aiRequestCancel() {
    aiViewFactsEnsure()
    var facts = nativeRecover<AiViewFacts>(kiraUiStateSlotGet(aiViewSlotKey()))
    if facts.running {
        facts.pendingCancelRaw = facts.conversation.raw
    }
    return
}

function aiNewConversation() {
    aiViewFactsEnsure()
    var facts = nativeRecover<AiViewFacts>(kiraUiStateSlotGet(aiViewSlotKey()))
    if facts.running {
        facts.pendingCancelRaw = facts.conversation.raw
    }
    facts.conversation = conversationNone()
    facts.prompt = ""
    facts.answer = ""
    facts.running = false
    facts.activities = []
    return
}

// The component loop consumes these rather than callbacks reaching into its
// network client. That keeps transport ownership in one place.
function aiTakePendingPrompt() -> String {
    aiViewFactsEnsure()
    var facts = nativeRecover<AiViewFacts>(kiraUiStateSlotGet(aiViewSlotKey()))
    // A turn already in flight owns the harness channel. Keep a submitted
    // follow-up queued until that turn finishes; sending it now would let the
    // harness's between-round cancel poll consume the Turn frame as unrelated.
    if facts.running {
        return ""
    }
    let prompt = facts.pendingPrompt
    facts.pendingPrompt = ""
    return prompt
}

function aiTakeCancelConversation() -> ConversationId {
    aiViewFactsEnsure()
    var facts = nativeRecover<AiViewFacts>(kiraUiStateSlotGet(aiViewSlotKey()))
    if facts.pendingCancelRaw <= 0 {
        return conversationNone()
    }
    let conversation = ConversationId(facts.pendingCancelRaw)
    facts.pendingCancelRaw = 0
    return conversation
}

function aiConversationForNextTurn() -> ConversationId {
    let facts = aiViewFacts()
    if conversationPresent(facts.conversation) {
        return facts.conversation
    }
    return ConversationId(facts.nextConversationRaw)
}

// --- What the views ask ------------------------------------------------------

function aiHasConversation() -> Bool {
    return conversationPresent(aiViewFacts().conversation)
}

function aiCurrentConversation() -> ConversationId {
    return aiViewFacts().conversation
}

// A conversation is named by what was asked in it. Nothing else is available to
// name one by until a runtime can answer, and a list of "Conversation 1" is a
// list that tells a person nothing they did not already know.
function aiCurrentTitle() -> String {
    let facts = aiViewFacts()
    if facts.prompt.count > 0 {
        return facts.prompt
    }
    return "Untitled"
}

function aiCurrentPrompt() -> String {
    return aiViewFacts().prompt
}

function aiCurrentAnswer() -> String {
    let facts = aiViewFacts()
    if facts.answer.count > 0 {
        return facts.answer
    }
    if facts.running {
        return "Working…"
    }
    return facts.note
}

function aiIsRunning() -> Bool {
    return aiViewFacts().running
}

function aiActivityCount() -> Int {
    return aiViewFacts().activities.count
}

function aiActivityAt(index: Int) -> AiActivityFact {
    let facts = aiViewFacts()
    if index < 0 || index >= facts.activities.count {
        return AiActivityFact {}
    }
    return facts.activities[index]
}

function aiActivityStateLabel(state: borrow String) -> String {
    if state == "started" {
        return "Running"
    }
    if state == "failed" {
        return "Failed"
    }
    return "Done"
}

// The same shape the browser's tab count has, singular and all.
//
// These two columns are not merely similar screens: the window crossfades one
// into the other, so a count that read "0 tabs" on one side and "None" on the
// other would change its own idiom halfway through a swipe.
function aiConversationCountLabel() -> String {
    if aiHasConversation() {
        return "1 conversation"
    }
    return "0 conversations"
}

// What is answering, or why nothing is.
function aiRuntimeLabel() -> String {
    let facts = aiViewFacts()
    if facts.runtimeReady && facts.model.count > 0 {
        return facts.model
    }
    return "No model loaded"
}

// What is missing, in three or four words -- the same shape the browser's empty
// page area uses, because it answers the same question.
function aiHeadline() -> String {
    let facts = aiViewFacts()
    if facts.runtimeReady {
        return "Ask anything"
    }
    return "No model installed"
}

function aiExplanation() -> String {
    let facts = aiViewFacts()
    if facts.runtimeReady {
        return "Start a conversation from the column beside this one."
    }
    if facts.note.count > 0 {
        return facts.note
    }
    return "Install a model runtime beside Harmony AI to ask anything."
}

function aiInspectorPrompt() -> String {
    if aiHasConversation() {
        return aiCurrentTitle()
    }
    return "Select something and ask about it."
}
