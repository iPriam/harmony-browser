import Foundation
import HarmonyCore
import HarmonyAiHarness
import HarmonyAiRuntime
import KiraIpc

// Harmony AI: a runtime, the harness that drives it, and the views that show it,
// in a process of their own.
//
// The runtime seam and the harness are packages beside this one, so what is
// left here is the component: which runtime is loaded, what is drawn, and the
// loop that ties the two to the shell.
//
// It owns no window. The shell owns the window and every pixel in it; this
// answers what the shell asks and announces what it produces. That is what makes
// the AI runtime installable on its own: a person who installs it beside Harmony
// Browser gets AI in the browser they already have, and a person who installs it
// alone gets a shell with a conversation in it and no web engine behind them.
//
// The loop is the whole program. It settles the attachment, serves what arrives
// and lets the runtime produce whatever it has, once per turn, until the shell
// goes.

function harmonyAiVersion() -> String {
    return "0.1.0"
}

@Main
function entry() {
    var attachment = harmonyAttach(HarmonyComponent.Ai, harmonyAiVersion())
    let runtime = AiNoModelRuntime()
    var harness = AiHarness {}
    // The pixels, once the window has said how big they are.
    //
    // Not at startup: a texture is opened at an extent, the extent is the
    // window's to decide, and a component that opened one before being told
    // would be opening it at a guess.
    var surfaces = AiSurfaces {}
    var reported = false

    while attachment.shouldRun() {
        attachment.settle()
        var worked = false
        let delivery = attachment.pump()
        if delivery.arrived() {
            let moved = aiPointer(surfaces, delivery)
            if harmonyAiAllot(surfaces, delivery) {
                if surfaces.isReady() == false && surfaces.note().count > 0 && reported == false {
                    print("harmony-ai: " + surfaces.note())
                    reported = true
                }
            }
            harness = aiHarnessServe(move harness, attachment, runtime, delivery)
            worked = true
        }
        if attachment.isAttached() {
            // Drawn before it is announced, so the first frame the shell
            // composites is one that has been written: a surface handed over
            // empty is a rectangle of whatever the allocator last had in it.
            // What the views draw, refreshed before they are drawn. The turn is
            // the harness's and the capabilities are the runtime's, and neither
            // is a thing a widget should be reaching into.
            aiViewRecord(harness.session, runtime.capabilities(), harness.session.prompt)
            if aiDrawSurfaces(surfaces) {
                aiAnnounceSurfaces(attachment, surfaces)
            }
            harness = aiHarnessRelay(move harness, attachment, runtime)
        }
        if worked == false {
            sleepMilliseconds(aiHarnessIdleMilliseconds())
        }
    }

    // The shell has gone, or would not have us. Either way there is nothing
    // left to answer.
    attachment.detach()
    return
}
