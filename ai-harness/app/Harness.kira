import HarmonyCore
import HarmonyAiRuntime
import KiraIpc

// What drives a runtime: the turn in flight, the calls the shell makes, and the
// deltas that go back.
//
// The seam beside this one -- `HarmonyAiRuntime` -- says what a runtime IS. This
// says what is done with one. They are separate packages because they have
// separate authors: writing a runtime means answering four calls and nothing
// else, and a person doing that should not have to read, build, or depend on the
// protocol plumbing that calls them.
//
// Nothing here draws. A component that shows a conversation composes this with
// its own views; a component that shows nothing -- a runtime running headless
// beside a shell that draws its own -- composes this alone and is complete.

// The turn in flight, and nothing else.
//
// The state lives here rather than inside the runtime for the reason the seam
// gives: a shell may have several conversations open, and which turn is running
// is what routes every delta. A runtime that also kept it would be a second copy
// of a truth this one has to have.
struct AiHarness {
    var session: AiSession = AiSession {}
}

// How long a component waits when there is nothing to do.
//
// A component with no work must not spin: it is on the same machine as the
// window, and a core spent asking an empty socket is a core the page is not
// getting. Sixteen milliseconds is a frame, which is as often as anything the
// shell draws could show a change anyway.
function aiHarnessIdleMilliseconds() -> Int {
    return 16
}

// Answer one thing the shell asked.
function aiHarnessServe(harness: AiHarness, attachment: borrow mut HarmonyAttachment, runtime: borrow Any AiRuntime, delivery: borrow IpcDelivery) -> AiHarness {
    if delivery.sound() == false {
        // A frame this build could not read. The shell is told nothing: it is
        // not waiting on a call it did not successfully make, and answering a
        // call number carved out of unreadable bytes would be worse than
        // silence.
        return harness
    }
    let method = delivery.envelope.method
    if method == aiCapabilitiesMethod() {
        var answer = IpcWriter {}
        encode_AiCapabilities(runtime.capabilities(), answer)
        let ignored = attachment.respond(delivery.envelope.call, aiCapabilitiesMethod(), answer.bytes)
        return harness
    }
    if method == aiSendMethod() {
        var reader = ipcPayloadReader(delivery.envelope)
        let turn = decode_AiTurn(reader)
        if reader.ok() {
            return AiHarness {
                session: runtime.begin(move harness.session, turn.conversation, turn.text)
            }
        }
        return harness
    }
    if method == aiCancelMethod() {
        var reader = ipcPayloadReader(delivery.envelope)
        let cancel = decode_AiCancel(reader)
        if reader.ok() {
            return AiHarness {
                session: runtime.cancel(move harness.session, cancel.conversation)
            }
        }
        return harness
    }
    return harness
}

// Send on whatever the runtime has produced since the last turn.
function aiHarnessRelay(harness: AiHarness, attachment: borrow mut HarmonyAttachment, runtime: borrow Any AiRuntime) -> AiHarness {
    let step = runtime.advance(move harness.session)
    // An absent conversation is how a runtime says it has nothing, so it is
    // never a conversation a shell can open.
    if conversationPresent(step.delta.conversation) == false {
        return AiHarness { session: step.session }
    }
    var out = IpcWriter {}
    encode_AiDelta(step.delta, out)
    let ignored = attachment.emit(aiDeltaMethod(), out.bytes)
    return AiHarness { session: step.session }
}
