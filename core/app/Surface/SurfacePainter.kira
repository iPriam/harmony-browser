import Foundation
import KiraGraphics
import KiraLayout
import KiraUI
import KCoreAnimation

// Drawing a widget tree into a shared texture.
//
// This is the whole point of a component: it is a KiraUI application that
// happens to have no window. The tree is built, described, laid out and
// composited exactly as a window's is — same widgets, same `describe`, same
// layout engine, same compositor — and the only thing that differs is the image
// the final pass names. A view cannot tell, and that is the property worth
// having: a sidebar written for a window is the same sidebar written for a
// compositor.
//
// The batch and the compositor are kept BETWEEN frames, not built per frame. The
// batch owns the glyph atlas, the pipelines and the vertex streams; the
// compositor owns the retained layer tree the pointer hit-tests against.
struct HarmonySurfacePainter {
    // `.None` until a device opens the painter. `UiBatch` owns its state through
    // a `NativeState` handle, so there is no null batch to stand in — an
    // unopened painter simply has no batch.
    var batch: Option<UiBatch> = .None
    // The retained tree the last paint reconciled and the pointer hit-tests
    // against. One painter serves every surface this component has, and only one
    // surface is under the pointer at a time, so a single tree is the right place
    // for it — the last surface painted is the one the pointer is resolved on.
    var compositor: Compositor = Compositor {}
    var frames: Int = 0
    var ready: Bool = false
    // What the window's pointer has done to this component's tree.
    //
    // KEPT between frames, because that is what hover and press ARE: a pointer
    // resting on a row is a fact about the last event, not about this frame.
    var ui: FoundationUiContext = FoundationUiContext {}
}

// A not-ready headless device that owns no GPU resources: a valid placeholder a
// surface set can hold before the shell allots it anything, without opening a
// device speculatively. `GraphicsHeadless` is a single-owner native value now
// (its `context` carries the runtime state), so it has no `{}` default — this is
// the one a component stands on until `openHeadlessGraphics` replaces it.
function harmonyNoDevice() -> GraphicsHeadless {
    return GraphicsHeadless {
        context: nativeState(GraphicsAppRuntimeState {
            app: GraphicsApplication {},
            userData: nullPointer()
        }),
        ready: false
    }
}

function harmonyClosePainter(painter: borrow mut HarmonySurfacePainter) {
    if painter.ready == false {
        return
    }
    // Dropping the batch recursively releases its native state; there is no
    // `close` to call.
    painter.batch = .None
    painter.ready = false
    return
}

function harmonyOpenPainter(device: borrow GraphicsHeadless) -> HarmonySurfacePainter {
    if device.ready == false {
        return HarmonySurfacePainter {}
    }
    var batch = UiBatch { storage: createBatch(device.graphics) }
    // A component has no window background to promote. Said once, here, because
    // it is a property of what this batch is FOR rather than of any frame.
    batch.setBackgroundPromotable(false)
    return HarmonySurfacePainter {
        batch: .Some(move batch),
        frames: 0,
        ready: true
    }
}

// The context a widget describes against.
//
// A component has no pointer and no keyboard of its own: input belongs to the
// window, which owns the only real one, and reaches a component as messages
// about what was pressed rather than as coordinates. So everything here but the
// viewport, the frame count and the forwarded pointer state is zero.
function harmonyPaintContext(painter: borrow HarmonySurfacePainter, width: Int, height: Int) -> FoundationUiContext {
    return FoundationUiContext {
        frameCount: painter.frames,
        viewport: Size {
            width: Float(width),
            height: Float(height)
        },
        pointerX: painter.ui.pointerX,
        pointerY: painter.ui.pointerY,
        hoveredKey: painter.ui.hoveredKey,
        pressedKey: painter.ui.pressedKey,
        clickedKey: painter.ui.clickedKey,
        focusedKey: painter.ui.focusedKey,
        eventCount: painter.ui.eventCount
    }
}

// --- The window's pointer, in this surface's coordinates ---------------------
//
// A component is told WHERE, never what it means. The window owns the pointer
// and decides which surface it is over; this decides what is under it, by
// hit-testing the retained tree the last paint reconciled — the same
// `caHitTestTree` a window's own runner uses. Nothing here knows the event
// crossed a process boundary.

function harmonyPointerMoved(painter: borrow mut HarmonySurfacePainter, x: Float, y: Float) {
    painter.ui.pointerX = x
    painter.ui.pointerY = y
    let hit = caHitTestTree(painter.compositor.tree, x, y)
    if hit.hit {
        painter.ui.hoveredKey = hit.hitKey
    } else {
        painter.ui.hoveredKey = 0
    }
    painter.ui.eventCount = painter.ui.eventCount + 1
    harmonyPublishPointer(painter)
    return
}

// Put what the pointer established where the WIDGETS look for it.
//
// A widget asks `kiraUiHovered(key)`, which reads a process-wide snapshot rather
// than the context it was described against — so a component that kept its
// pointer state to itself would hit-test correctly yet draw every row as if
// nothing were under it. The window's own runner writes this snapshot on every
// event; a component does the same, and then its widgets cannot tell the
// difference.
function harmonyPublishPointer(painter: borrow HarmonySurfacePainter) {
    foundationWriteInputSnapshot(painter.ui)
    return
}

function harmonyPointerPressed(painter: borrow mut HarmonySurfacePainter, x: Float, y: Float) {
    painter.ui.pointerX = x
    painter.ui.pointerY = y
    let hit = caHitTestTree(painter.compositor.tree, x, y)
    if hit.hit {
        painter.ui.hoveredKey = hit.hitKey
        painter.ui.pressedKey = hit.hitKey
        painter.ui.clickedKey = hit.hitKey
        // The press runs the action the pressed key was bound to during the last
        // paint's `describe`.
        kiraUiLayerActionInvoke(hit.hitKey)
    }
    painter.ui.eventCount = painter.ui.eventCount + 1
    harmonyPublishPointer(painter)
    return
}

function harmonyPointerReleased(painter: borrow mut HarmonySurfacePainter, x: Float, y: Float) {
    painter.ui.pointerX = x
    painter.ui.pointerY = y
    painter.ui.pressedKey = 0
    painter.ui.eventCount = painter.ui.eventCount + 1
    harmonyPublishPointer(painter)
    return
}

// The pointer went somewhere else. Said explicitly rather than inferred from a
// move that never comes: a row left looking hovered after the pointer moved to
// the other component is a row that stays lit until something else happens.
function harmonyPointerLeft(painter: borrow mut HarmonySurfacePainter) {
    painter.ui.hoveredKey = 0
    painter.ui.pressedKey = 0
    harmonyPublishPointer(painter)
    return
}

// Build, describe, lay out, reconcile, composite and present into the surface.
//
// The access bracket is the same one a flat fill needs: ending it exports the
// fence that tells the shell the writing finished, and without it the compositor
// samples a half-drawn frame.
//
// The reconcile is IMMEDIATE: a component's surfaces are painted on demand and
// the painter's one retained tree serves each in turn, so every paint mounts its
// tree outright rather than animating a difference against whichever surface was
// painted last.
function harmonyPaintSurface(
    device: borrow GraphicsHeadless,
    painter: borrow mut HarmonySurfacePainter,
    surface: borrow mut HarmonyComponentSurface,
    root: Any Widget,
    background: borrow Color,
) -> Bool {
    if painter.ready == false || surface.isReady() == false {
        return false
    }
    let width = surface.shared.surface.width
    let height = surface.shared.surface.height
    if surface.shared.beginWrite() == false {
        return false
    }
    // The compositor encodes into a batch that SHARES the painter's retained
    // state (glyph atlas, pipelines, vertex stream) rather than owning it. The
    // painter keeps its own handle, so the state persists between frames; the
    // alias is a fresh `UiBatch` over the same native user data.
    match harmonyBatchAlias(painter.batch) {
        None -> return false
        Some(aliasBatch) -> {
            var batch = aliasBatch
            let viewport = Size {
                width: Float(width),
                height: Float(height)
            }
            let context = harmonyPaintContext(painter, width, height)
            let widgetContext = buildContext(context)
            // A fresh action table for this paint: `describe` binds each hittable
            // layer's press action under its key as it produces the description.
            kiraUiTapSeqReset()
            kiraUiLayerActionsReset()
            var described = root.describe(widgetContext, ModifierContext {})
            caLayoutTree(described, viewport.width, viewport.height)
            let ignoredReconcile = caReconcileImmediate(painter.compositor.tree, described)
            var frame = device.frame()
            let ignoredAdvance = caCompositorAdvance(painter.compositor, frame)
            let ignoredEncode = caCompositorEncode(
                painter.compositor,
                frame,
                device.graphics,
                batch,
                viewport.width,
                viewport.height,
                1.0,
                false
            )
            batch.presentBatchIntoTexture(
                frame,
                device.graphics,
                surface.shared.texture,
                background.r,
                background.g,
                background.b,
                background.a
            )
            device.submit()
            let ended = surface.shared.endAccess()
            device.tick()
            painter.frames = painter.frames + 1
            return ended
        }
    }
}

// A batch that shares the painter's retained state without owning it: a fresh
// `UiBatch` over the same native user data, or `.None` when the painter has no
// batch yet. The result must not outlive the painter's own handle.
function harmonyBatchAlias(batch: borrow Option<UiBatch>) -> Option<UiBatch> {
    match batch {
        None -> return .None
        Some(real) -> return .Some(UiBatch { storage: nativeUserData(real.storage) })
    }
}
