import HarmonyCore
import KiraGraphics
import Foundation
import KiraUI
import KCoreAnimation

// The shell's own runner.
//
// The retained runner rebuilds and reconciles every frame and lets the
// compositor animate the difference, so the old "rebuild only on input" predicate
// the shell had to override is gone: a component connecting, naming its version
// and stopping — all on its own schedule, none of it on the person's — is simply
// the next frame's reconcile. The arrangement is still advanced inside the build,
// where a wrapped property can find the build's own state, before the tree is
// produced. `ui shot --app harmony-shell` still captures this window: the
// window's harness resolves from the environment by default.
function RunHarmonyShellApp(
    title: String,
    width: Int,
    height: Int,
    rootBuilder: borrow () -> Any Widget,
) {
    let userRoot: borrow () -> Any Widget = rootBuilder
    RunKiraWindowApp(move title, width, height, { in
        kiraUiTapSeqReset()
        harmonyShellAdvance(Size {
            width: kiraUiViewportWidth(),
            height: kiraUiViewportHeight()
        })
        return userRoot()
    }, harmonyShellFrame)
    return
}

// Once per frame, before the window draws: import whatever a component handed
// over since the last one.
//
// Here rather than in the build because importing needs the FRAME, and the build
// is the one place that does not have one. The build records what arrived; this
// turns it into a texture.
function harmonyShellFrame(frame: borrow mut KiraGraphics.RenderFrame) {
    harmonyShellImportPending(frame)
    return
}

